         logger.error(f"Error checking authentication: {e}")
     
     logger.debug(f"Did not find user [{user_id}] in the database.")
-    return 0
\ No newline at end of file
+    return 0
+
+# NIX PATCH: declarative users (settings.searcharr_declarative). The Nix-generated
+# settings.searcharr_users is the only source of who is a user/admin; the users table is ignored
+# and never written. Upstream callers import these names, so they get the wrappers.
+from bot import declarative as _decl
+
+_db_add_user, _db_remove_user, _db_get_users = add_user, remove_user, get_users
+_db_update_admin_access, _db_authenticated = update_admin_access, authenticated
+
+
+def add_user(id, username, admin=""):
+    if _decl.enabled():
+        logger.info(f"Declarative users: not adding user id={id} (managed by Nix)")
+        return True
+    return _db_add_user(id, username, admin)
+
+
+def remove_user(id):
+    if _decl.enabled():
+        logger.info(f"Declarative users: not removing user id={id} (managed by Nix)")
+        return True
+    return _db_remove_user(id)
+
+
+def update_admin_access(user_id, admin=""):
+    if _decl.enabled():
+        logger.info(f"Declarative users: not changing admin for id={user_id} (managed by Nix)")
+        return True
+    return _db_update_admin_access(user_id, admin)
+
+
+def get_users(admin=False):
+    if _decl.enabled():
+        rows = _decl.user_rows()
+        return [r for r in rows if r["admin"]] if admin else rows
+    return _db_get_users(admin)
+
+
+def authenticated(user_id):
+    if _decl.enabled():
+        u = _decl.users().get(int(user_id))
+        if u is None:
+            return 0
+        return 2 if u.get("admin") else 1
+    return _db_authenticated(user_id)
