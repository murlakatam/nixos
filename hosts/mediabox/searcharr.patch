diff --git a/bot/searcharr_bot.py b/bot/searcharr_bot.py
--- a/bot/searcharr_bot.py
+++ b/bot/searcharr_bot.py
@@ -5,7 +5,13 @@
 By Todd Roberts
 https://github.com/toddrob99/searcharr
 """
-from telegram.ext import ApplicationBuilder, CallbackQueryHandler
+from telegram import Update
+from telegram.ext import (
+    ApplicationBuilder,
+    ApplicationHandlerStop,
+    CallbackQueryHandler,
+    TypeHandler,
+)
 
 from api.sonarr import Sonarr
 from api.radarr import Radarr
@@ -117,6 +123,22 @@
         # Build the application
         application = ApplicationBuilder().token(self.token).job_queue(None).build()
         
+        # NIX PATCH (security): Telegram user-ID allow-list, checked BEFORE every other handler
+        # (handler group -1) for all updates: commands, callbacks, everything. An update from
+        # anyone not in settings.searcharr_allowed_user_ids is dropped silently, so the shared
+        # password alone is not enough. Fails closed: missing/empty list allows nobody.
+        allowed = {int(i) for i in getattr(settings, "searcharr_allowed_user_ids", [])}
+
+        async def _allow_list_gate(update, context):
+            user = update.effective_user
+            if user is None or user.id not in allowed:
+                self.logger.warning(
+                    f"Dropped update from non-allow-listed user id={getattr(user, 'id', None)}"
+                )
+                raise ApplicationHandlerStop
+
+        application.add_handler(TypeHandler(Update, _allow_list_gate), group=-1)
+
         # Register command handlers from each module
         register_commands(application, self)
         
