diff --git a/bot/status.py b/bot/status.py
--- a/bot/status.py
+++ b/bot/status.py
@@ -0,0 +1,315 @@
+"""
+NIX PATCH: /status command. Shows the family's bot requests (notify_requests table, see
+bot/notify.py) with their live state: still searching, downloading (table with %, speed, time
+left), or ready in Plex. Text never names Radarr/Sonarr.
+
+Settings:
+  searcharr_status_enabled           bool
+  searcharr_status_command_aliases   list[str]
+  transmission_url                   str   (RPC endpoint, e.g. http://127.0.0.1:9091/transmission/rpc)
+  transmission_username / transmission_password   str (optional; without them no speed column data)
+"""
+import asyncio
+import html
+import textwrap
+import time
+
+import arrow
+import requests
+
+import settings
+from bot.notify import init_tables, prune, requester_name
+from bot.utils.auth import authenticated
+from bot.utils.database import execute_query
+from bot.utils.log import set_up_logger
+from config.language import translate
+
+logger = set_up_logger("status")
+
+READY_MAX = 5
+READY_MAX_AGE = 14 * 24 * 3600
+TABLE_MAX = 15
+SEARCH_MAX = 15
+TITLE_W = 14
+
+
+def _arr(app):
+    if app == "radarr":
+        return settings.radarr_url, settings.radarr_api_key
+    return settings.sonarr_url, settings.sonarr_api_key
+
+
+def _get(app, endpoint, params=None):
+    url, key = _arr(app)
+    r = requests.get(
+        f"{url}/api/v3/{endpoint}", params=params or {}, headers={"X-Api-Key": key}, timeout=15
+    )
+    if r.status_code == 404:
+        return None
+    r.raise_for_status()
+    return r.json()
+
+
+def _queue(app):
+    """{item id: [queue records]} for one arr."""
+    data = _get(app, "queue", {"pageSize": 500}) or {}
+    out = {}
+    id_key = "movieId" if app == "radarr" else "seriesId"
+    for rec in data.get("records", []):
+        if rec.get(id_key) is not None:
+            out.setdefault(int(rec[id_key]), []).append(rec)
+    return out
+
+
+def _transmission(hashes):
+    """{lowercase hash: torrent dict} or {} if Transmission is unreachable/unset."""
+    url = getattr(settings, "transmission_url", None)
+    if not url or not hashes:
+        return {}
+    auth = None
+    if getattr(settings, "transmission_username", None):
+        auth = (settings.transmission_username, settings.transmission_password)
+    body = {
+        "method": "torrent-get",
+        "arguments": {
+            "ids": sorted(hashes),
+            "fields": ["hashString", "rateDownload", "percentDone", "eta", "status"],
+        },
+    }
+    try:
+        headers = {}
+        for _ in range(2):  # first call returns 409 with the session id
+            r = requests.post(url, json=body, auth=auth, headers=headers, timeout=10)
+            if r.status_code == 409:
+                headers = {"X-Transmission-Session-Id": r.headers.get("X-Transmission-Session-Id", "")}
+                continue
+            r.raise_for_status()
+            torrents = r.json().get("arguments", {}).get("torrents", [])
+            return {t["hashString"].lower(): t for t in torrents if t.get("hashString")}
+    except Exception as e:
+        logger.warning(f"Transmission unreachable, no speed data: {type(e).__name__}")
+    return {}
+
+
+def _timeleft_secs(s):
+    """arr timeleft '1.02:03:04' / '02:03:04' -> seconds."""
+    if not s:
+        return None
+    try:
+        days = 0
+        if "." in s.split(":")[0]:
+            d, s = s.split(".", 1)
+            days = int(d)
+        h, m, sec = (int(float(x)) for x in s.split(":"))
+        return days * 86400 + h * 3600 + m * 60 + sec
+    except Exception:
+        return None
+
+
+def _fmt_speed(bps):
+    if bps is None:
+        return "-"
+    if bps >= 1024 * 1024:
+        return f"{bps / 1048576:.1f}M"
+    if bps >= 1024:
+        return f"{bps // 1024}K"
+    return "0"
+
+
+def _fmt_eta(secs):
+    if secs is None or secs < 0:
+        return "-"
+    if secs < 3600:
+        return f"{max(1, secs // 60)}{translate('status_min')}"
+    if secs < 86400:
+        return f"{secs // 3600}:{(secs % 3600) // 60:02d}"
+    return f"{secs // 86400}{translate('status_days')}"
+
+
+def _cut(text, width):
+    return text if len(text) <= width else text[: width - 1] + "…"
+
+
+def _ago(ts):
+    # NIX PATCH: arrow's Belarusian "seconds" form is broken ("24 некалькі секунд таму")
+    if time.time() - float(ts) < 60:
+        return translate("status_just_now")
+    try:
+        return arrow.get(ts).humanize(locale=translate("status_locale"))
+    except Exception:
+        return arrow.get(ts).humanize()
+
+
+def _download_row(app, item, recs, torrents):
+    """Aggregate queue records of one item (season packs have one record per episode)."""
+    by_dl = {}
+    for rec in recs:
+        by_dl.setdefault(rec.get("downloadId") or f"r{rec.get('id')}", rec)
+    size = sum(float(r.get("size") or 0) for r in by_dl.values())
+    left = sum(float(r.get("sizeleft") or 0) for r in by_dl.values())
+    pct = int(100 * (1 - left / size)) if size else 0
+    speed, eta, note = None, None, None
+    tor = [torrents.get(str(d).lower()) for d in by_dl if torrents.get(str(d).lower())]
+    if tor:
+        speed = sum(t.get("rateDownload") or 0 for t in tor)
+        etas = [t.get("eta") for t in tor if (t.get("eta") or -1) >= 0]
+        eta = max(etas) if etas else None
+        if all(t.get("status") in (0,) for t in tor):
+            note = translate("status_paused")
+        elif all(t.get("status") in (1, 2, 3) for t in tor):
+            note = translate("status_queued")
+        elif not speed and eta is None:
+            note = translate("status_stalled")
+        if len(tor) == len(by_dl):
+            pct = int(100 * sum(t.get("percentDone") or 0 for t in tor) / len(tor))
+    else:
+        secs = [x for x in (_timeleft_secs(r.get("timeleft")) for r in by_dl.values()) if x is not None]
+        eta = max(secs) if secs else None
+    states = {r.get("trackedDownloadState") for r in by_dl.values()}
+    if states & {"importPending", "importing", "importBlocked"} or pct >= 100:
+        note = translate("status_importing")
+    return pct, speed, eta, note
+
+
+def build_status():
+    """Return the HTML status message (blocking: call in a thread)."""
+    init_tables()
+    now = time.time()
+    prune()
+    rows = execute_query(
+        "SELECT * FROM notify_requests WHERE IFNULL(done,0)=0 OR IFNULL(imported_at,requested_at)>=? "
+        "ORDER BY requested_at DESC;",
+        (now - READY_MAX_AGE,),
+    ) or []
+    if not rows:
+        return translate("status_empty")
+
+    queues, items = {}, {}
+    for app in {r["app"] for r in rows}:
+        try:
+            queues[app] = _queue(app)
+        except Exception as e:
+            logger.error(f"Queue fetch failed for {app}: {type(e).__name__}")
+            queues[app] = {}
+    seen = set()
+    for r in rows:
+        k = (r["app"], int(r["item_id"]))
+        if k in seen:
+            continue
+        seen.add(k)
+        try:
+            items[k] = _get(r["app"], f"{'movie' if r['app'] == 'radarr' else 'series'}/{k[1]}")
+        except Exception as e:
+            logger.error(f"Item fetch failed for {k}: {type(e).__name__}")
+            items[k] = "error"
+    hashes = {
+        str(rec.get("downloadId")).lower()
+        for q in queues.values()
+        for recs in q.values()
+        for rec in recs
+        if rec.get("downloadId")
+    }
+    torrents = _transmission(hashes)
+
+    downloading, searching, ready, gone = [], [], [], []
+    shown = set()
+    for r in rows:
+        app, iid = r["app"], int(r["item_id"])
+        k = (app, iid)
+        if k in shown:  # same item requested by two people: list once
+            continue
+        shown.add(k)
+        item = items.get(k)
+        who = requester_name(int(r["user_id"]))  # raw; escaped when rendered
+        title = r.get("title") or (item.get("title") if isinstance(item, dict) else None) or "?"
+        if item is None:
+            gone.append((title, who))
+            continue
+        if item == "error":
+            searching.append((title, who, translate("status_unknown")))
+            continue
+        files = None
+        if app == "sonarr":
+            st = item.get("statistics") or {}
+            have, total = int(st.get("episodeFileCount") or 0), int(st.get("episodeCount") or 0)
+            files = translate("status_episodes", have=have, total=total) if total else None
+            has = have > 0
+        else:
+            has = bool(item.get("hasFile"))
+        if iid in queues.get(app, {}):
+            downloading.append((title, who, _download_row(app, item, queues[app][iid], torrents)))
+        elif has:
+            ready.append((title, who, files, r.get("imported_at") or r.get("requested_at")))
+        else:
+            searching.append((title, who, _ago(float(r["requested_at"]))))
+
+    parts = [translate("status_header")]
+    if downloading:
+        lines = [
+            f"{translate('status_col_title'):<{TITLE_W}} {'%':>3} {translate('status_col_speed'):>5} {translate('status_col_left'):>6}"
+        ]
+        for title, who, (pct, speed, eta, note) in downloading[:TABLE_MAX]:
+            right = (
+                f"{pct:>3} {_cut(note, 12):>12}"
+                if note
+                else f"{pct:>3} {_fmt_speed(speed):>5} {_fmt_eta(eta):>6}"
+            )
+            # NIX PATCH: word-wrap long titles inside the title column instead of cutting them
+            wrapped = textwrap.wrap(title, TITLE_W) or ["?"]
+            lines.append(f"{wrapped[0]:<{TITLE_W}} {right}")
+            lines.extend(wrapped[1:])
+            lines.append(f" └ {_cut(who, TITLE_W + 14)}")
+        parts.append(
+            translate("status_downloading")
+            + "\n<pre>"
+            + html.escape("\n".join(lines))
+            + "</pre>"
+        )
+    if searching:
+        parts.append(
+            translate("status_searching")
+            + "\n"
+            + "\n".join(
+                f"• {html.escape(t)}: {html.escape(w)}, {html.escape(a)}"
+                for t, w, a in searching[:SEARCH_MAX]
+            )
+        )
+    if ready:
+        ready.sort(key=lambda x: -float(x[3] or 0))
+        parts.append(
+            translate("status_ready")
+            + "\n"
+            + "\n".join(
+                f"• {html.escape(t)}{f' ({html.escape(f)})' if f else ''}: {html.escape(w)}"
+                for t, w, f, _ in ready[:READY_MAX]
+            )
+        )
+    if gone:
+        parts.append(
+            translate("status_gone")
+            + "\n"
+            + "\n".join(f"• {html.escape(t)}: {html.escape(w)}" for t, w in gone[:SEARCH_MAX])
+        )
+    return "\n\n".join(parts)
+
+
+async def status_command(update, context, bot):
+    """Handle /status (passes the allow-list gate like every other handler)."""
+    user = update.message.from_user
+    if not authenticated(user.id):
+        await update.message.reply_text(
+            translate(
+                "auth_required",
+                commands=" OR ".join(
+                    [f"`/{c} <{translate('password')}>`" for c in settings.searcharr_start_command_aliases]
+                ),
+            )
+        )
+        return
+    try:
+        text = await asyncio.to_thread(build_status)
+    except Exception as e:
+        logger.error(f"/status failed: {type(e).__name__}: {e}")
+        text = translate("unexpected_error")
+    logger.info(f"/status for user id={user.id}: {len(text)} chars")
+    await update.message.reply_text(text, parse_mode="HTML", disable_web_page_preview=True)
