+"""
+NIX PATCH: Telegram command menu (setMyCommands), registered once at startup when
+settings.searcharr_command_menu is True. Descriptions are the same strings /help uses
+(help_desc_*). First alias of each command only.
+
+  default scope + all group chats: series, movie, status, help (whichever are enabled)
+  each admin's private chat:       the same + users
+
+Any failure is logged and ignored: the bot always starts.
+"""
+from telegram import BotCommand, BotCommandScopeAllGroupChats, BotCommandScopeChat, BotCommandScopeDefault
+
+import settings
+from bot.utils.auth import get_users
+from bot.utils.log import set_up_logger
+from config.language import translate
+
+logger = set_up_logger("command_menu")
+
+
+def _first(name, default):
+    aliases = getattr(settings, name, None) or [default]
+    return aliases[0]
+
+
+def menu_commands():
+    """(everyone, admins) lists of (command, description)."""
+    base = []
+    if getattr(settings, "sonarr_enabled", False):
+        base.append((_first("sonarr_series_command_aliases", "series"), translate("help_desc_series")))
+    if getattr(settings, "radarr_enabled", False):
+        base.append((_first("radarr_movie_command_aliases", "movie"), translate("help_desc_movie")))
+    if getattr(settings, "searcharr_status_enabled", False):
+        base.append((_first("searcharr_status_command_aliases", "status"), translate("help_desc_status")))
+    base.append((_first("searcharr_help_command_aliases", "help"), translate("help_desc_help")))
+    admin = base + [(_first("searcharr_users_command_aliases", "users"), translate("help_desc_users"))]
+    return base, admin
+
+
+async def register_menu(application):
+    """post_init hook. Never raises."""
+    if not getattr(settings, "searcharr_command_menu", False):
+        return
+    try:
+        base, admin = menu_commands()
+        everyone = [BotCommand(c, d) for c, d in base]
+        admins = [BotCommand(c, d) for c, d in admin]
+        admin_ids = [int(u["id"]) for u in get_users(admin=True)]
+    except Exception as e:
+        logger.warning(f"Command menu not registered: {type(e).__name__}: {e}")
+        return
+    targets = [("default", BotCommandScopeDefault(), everyone), ("all groups", BotCommandScopeAllGroupChats(), everyone)]
+    targets += [(f"admin chat {i}", BotCommandScopeChat(chat_id=i), admins) for i in admin_ids]
+    for label, scope, cmds in targets:
+        try:
+            await application.bot.set_my_commands(cmds, scope=scope)
+            logger.info(f"Command menu set for {label}: {', '.join('/' + c.command for c in cmds)}")
+        except Exception as e:  # e.g. an admin who never opened a private chat with the bot
+            logger.warning(f"Command menu for {label} failed: {type(e).__name__}: {e}")
