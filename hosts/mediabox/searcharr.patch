diff --git a/bot/notify.py b/bot/notify.py
--- a/bot/notify.py
+++ b/bot/notify.py
@@ -0,0 +1,381 @@
+"""
+NIX PATCH: "available in Plex" notifications.
+
+A tiny stdlib HTTP server (daemon thread, 127.0.0.1 only) receives Radarr/Sonarr Webhook
+connection calls. On an import ("Download", not an upgrade) of an item that carries the arr tag
+searcharr-<telegram user id> (set by the bot when that user requested it), it posts a message
+naming the requester into settings.searcharr_notify_chat_id.
+
+Failure messages (only when searcharr_notify_failures_enabled is also True):
+  - nothing found: no grab in arr history FAILURE_NOT_FOUND_AFTER after the request (once)
+  - download failed: a downloadFailed history event (once per history event)
+  - import stuck: webhook eventType ManualInteractionRequired (once per item and download id)
+Bot requests are remembered in the notify_requests table (written by the add callbacks, see
+record_request); sent messages are remembered in notify_sent, so restarts never repeat them.
+A daemon thread checks the history of each tracked request every CHECK_INTERVAL; tracking ends
+on import (Download webhook or import seen in history) or after TRACK_MAX_AGE.
+
+Settings (all optional; listener only starts when searcharr_notify_enabled is True):
+  searcharr_notify_enabled           bool
+  searcharr_notify_port              int   (bind 127.0.0.1:<port>)
+  searcharr_notify_chat_id           int   (group chat id)
+  searcharr_notify_secret            str   (required value of the X-Searcharr-Secret header)
+  searcharr_notify_failures_enabled  bool
+"""
+import hmac
+import html
+import json
+import re
+import threading
+import time
+from http.server import BaseHTTPRequestHandler, ThreadingHTTPServer
+
+import arrow
+import requests
+
+import settings
+from bot.utils.auth import get_users
+from bot.utils.database import execute_query
+from bot.utils.log import set_up_logger
+from config.language import translate
+
+logger = set_up_logger("notify")
+
+TAG_RE = re.compile(r"^searcharr-(\d+)$")
+DEBOUNCE_SECONDS = 600
+MAX_BODY = 1024 * 1024
+CHECK_INTERVAL = 600
+FIRST_CHECK_DELAY = 60
+FAILURE_NOT_FOUND_AFTER = 30 * 60
+TRACK_MAX_AGE = 14 * 24 * 3600
+APP_KIND = {"radarr": "movie", "sonarr": "series"}
+KIND_APP = {v: k for k, v in APP_KIND.items()}
+IMPORTED_EVENTS = {"downloadFolderImported", "movieFolderImported", "seriesFolderImported"}
+
+_sent = {}  # (kind, item id, requester id) -> monotonic time of last message
+_sent_lock = threading.Lock()
+
+
+def _should_send(key):
+    """At most one message per key per DEBOUNCE_SECONDS; prunes expired entries."""
+    now = time.monotonic()
+    with _sent_lock:
+        for k in [k for k, t in _sent.items() if now - t >= DEBOUNCE_SECONDS]:
+            del _sent[k]
+        if key in _sent:
+            return False
+        _sent[key] = now
+        return True
+
+
+def _failures_enabled():
+    return bool(getattr(settings, "searcharr_notify_enabled", False)) and bool(
+        getattr(settings, "searcharr_notify_failures_enabled", False)
+    )
+
+
+def init_tables():
+    """Create the notify tables if missing (idempotent)."""
+    execute_query(
+        """CREATE TABLE IF NOT EXISTS notify_requests (
+            app text not null,
+            item_id integer not null,
+            user_id integer not null,
+            title text,
+            requested_at real not null,
+            not_found_sent integer not null default 0,
+            primary key (app, item_id, user_id)
+        );"""
+    )
+    execute_query(
+        "CREATE TABLE IF NOT EXISTS notify_sent (key text primary key, sent_at real not null);"
+    )
+
+
+def record_request(app, added, user_id, title):
+    """Remember a successful bot add (called from the radarr/sonarr add callbacks). Never raises."""
+    try:
+        if not _failures_enabled():
+            return
+        item_id = added.get("id") if isinstance(added, dict) else None
+        if item_id is None:
+            logger.warning(f"Not tracking {app} request by {user_id}: add result has no id")
+            return
+        init_tables()
+        execute_query(
+            "INSERT OR IGNORE INTO notify_requests (app, item_id, user_id, title, requested_at) "
+            "VALUES (?, ?, ?, ?, ?);",
+            (app, int(item_id), int(user_id), str(title), time.time()),
+        )
+        logger.info(f"Tracking {app} id={item_id} requested by {user_id}")
+    except Exception as e:
+        logger.error(f"Could not record {app} request: {type(e).__name__}: {e}")
+
+
+def _stop_tracking(app, item_id, why):
+    execute_query("DELETE FROM notify_requests WHERE app=? AND item_id=?;", (app, int(item_id)))
+    logger.info(f"Stopped tracking {app} id={item_id}: {why}")
+
+
+def _claim(key):
+    """Persistent once-only marker. True if this call claimed key (message should be sent)."""
+    if execute_query("SELECT key FROM notify_sent WHERE key=?;", (key,)):
+        return False
+    execute_query("INSERT OR IGNORE INTO notify_sent (key, sent_at) VALUES (?, ?);", (key, time.time()))
+    return True
+
+
+def _arr_settings(kind):
+    if kind == "movie":
+        return settings.radarr_url, settings.radarr_api_key
+    return settings.sonarr_url, settings.sonarr_api_key
+
+
+def _resolve_tag_labels(kind, item):
+    """Tag labels of the item; payload labels if present, else looked up via the arr API."""
+    tags = item.get("tags") or []
+    if tags and all(isinstance(t, str) for t in tags):
+        return tags
+    url, key = _arr_settings(kind)
+    endpoint = "movie" if kind == "movie" else "series"
+    try:
+        if not tags:
+            r = requests.get(
+                f"{url}/api/v3/{endpoint}/{int(item['id'])}",
+                headers={"X-Api-Key": key},
+                timeout=10,
+            )
+            r.raise_for_status()
+            tags = r.json().get("tags") or []
+        if not tags:
+            return []
+        r = requests.get(f"{url}/api/v3/tag", headers={"X-Api-Key": key}, timeout=10)
+        r.raise_for_status()
+        labels = {t.get("id"): t.get("label", "") for t in r.json()}
+        return [labels.get(t, "") if isinstance(t, int) else str(t) for t in tags]
+    except Exception as e:
+        logger.error(f"Could not resolve tags for {endpoint} id={item.get('id')}: {type(e).__name__}")
+        return []
+
+
+def _requester_ids(labels):
+    ids = []
+    for label in labels:
+        if m := TAG_RE.match(str(label).strip().lower()):
+            ids.append(int(m.group(1)))
+    return ids
+
+
+def _mention(user_id):
+    username = None
+    for u in get_users():
+        if int(u.get("id", -1)) == user_id:
+            username = u.get("username")
+            break
+    if username and username not in ("None", ""):
+        return f"@{html.escape(username)}"
+    return f'<a href="tg://user?id={user_id}">{user_id}</a>'
+
+
+def _send(text):
+    r = requests.post(
+        f"https://api.telegram.org/bot{settings.tgram_token}/sendMessage",
+        json={
+            "chat_id": settings.searcharr_notify_chat_id,
+            "text": text,
+            "parse_mode": "HTML",
+            "disable_web_page_preview": True,
+        },
+        timeout=15,
+    )
+    if r.status_code != 200:
+        # never log the URL (it holds the token)
+        logger.error(f"Telegram sendMessage failed: HTTP {r.status_code}")
+        return False
+    return True
+
+
+def _history(app, item_id):
+    url, key = _arr_settings(APP_KIND[app])
+    endpoint, param = ("movie", "movieId") if app == "radarr" else ("series", "seriesId")
+    r = requests.get(
+        f"{url}/api/v3/history/{endpoint}",
+        params={param: int(item_id)},
+        headers={"X-Api-Key": key},
+        timeout=20,
+    )
+    r.raise_for_status()
+    data = r.json()
+    return data if isinstance(data, list) else data.get("records", [])
+
+
+def _parse_date(d):
+    try:
+        return arrow.get(d).timestamp()
+    except Exception:
+        return 0.0
+
+
+def check_request(row, now=None):
+    """Decide nothing-found / download-failed for one tracked request. Returns a decision string."""
+    now = time.time() if now is None else now
+    app, item_id, uid = row["app"], int(row["item_id"]), int(row["user_id"])
+    title = row.get("title") or "?"
+    age = now - float(row["requested_at"])
+    if age > TRACK_MAX_AGE:
+        _stop_tracking(app, item_id, "older than 14 days")
+        return f"{app} id={item_id}: expired"
+
+    events = [
+        e for e in _history(app, item_id) if _parse_date(e.get("date")) >= float(row["requested_at"]) - 120
+    ]
+    types = [e.get("eventType") for e in events]
+    out = []
+    for e in events:
+        if e.get("eventType") != "downloadFailed":
+            continue
+        # one message per failed download (a season pack logs one downloadFailed per episode)
+        ref = e.get("downloadId") or f"h{e.get('id')}"
+        if _claim(f"failed:{app}:{item_id}:{ref}:{uid}"):
+            text = translate("notify_download_failed", user=_mention(uid), title=html.escape(title))
+            out.append(f"download-failed(history id {e.get('id')}):{'sent' if _send(text) else 'failed'}")
+
+    if any(t in IMPORTED_EVENTS for t in types):
+        _stop_tracking(app, item_id, "imported")
+        out.append("imported")
+    elif "grabbed" not in types and age >= FAILURE_NOT_FOUND_AFTER and not row.get("not_found_sent"):
+        execute_query(
+            "UPDATE notify_requests SET not_found_sent=1 WHERE app=? AND item_id=? AND user_id=?;",
+            (app, item_id, uid),
+        )
+        text = translate("notify_not_found", user=_mention(uid), title=html.escape(title))
+        out.append(f"not-found:{'sent' if _send(text) else 'failed'}")
+    return f"{app} id={item_id} user={uid}: " + (",".join(out) or "nothing to do")
+
+
+def check_all():
+    rows = execute_query("SELECT * FROM notify_requests;") or []
+    for row in rows:
+        try:
+            logger.info(f"Failure check: {check_request(row)}")
+        except Exception as e:
+            logger.error(
+                f"Failure check error for {row.get('app')} id={row.get('item_id')}: {type(e).__name__}"
+            )
+
+
+def _checker_loop():
+    time.sleep(FIRST_CHECK_DELAY)
+    while True:
+        try:
+            check_all()
+        except Exception as e:
+            logger.error(f"Failure checker error: {type(e).__name__}: {e}")
+        time.sleep(CHECK_INTERVAL)
+
+
+def _handle_manual_interaction(kind, item, title, requesters, payload):
+    if not _failures_enabled():
+        return "ignored ManualInteractionRequired (failures disabled)"
+    download = payload.get("downloadId") or (payload.get("downloadInfo") or {}).get("downloadId") or "?"
+    sent = []
+    for uid in requesters:
+        if not _claim(f"manual:{KIND_APP[kind]}:{item.get('id')}:{download}:{uid}"):
+            sent.append(f"{uid}:already-sent")
+            continue
+        text = translate("notify_manual_import", user=_mention(uid), title=html.escape(title))
+        sent.append(f"{uid}:{'sent' if _send(text) else 'failed'}")
+    return f"manual-interaction {kind} id={item.get('id')} requesters " + ",".join(sent)
+
+
+def handle_event(payload):
+    """Process one webhook payload. Returns a short decision string (logged and returned)."""
+    event = payload.get("eventType")
+    if event not in ("Download", "ManualInteractionRequired"):
+        return f"ignored eventType={event}"
+    if event == "Download" and payload.get("isUpgrade"):
+        return "ignored upgrade"
+    if isinstance(payload.get("movie"), dict):
+        kind, item = "movie", payload["movie"]
+    elif isinstance(payload.get("series"), dict):
+        kind, item = "series", payload["series"]
+    else:
+        return "ignored: no movie/series in payload"
+
+    title = item.get("title") or "?"
+    if kind == "movie" and item.get("year"):
+        title = f"{title} ({item['year']})"
+
+    requesters = _requester_ids(_resolve_tag_labels(kind, item))
+    if not requesters:
+        return f"no searcharr-<id> tag on {kind} id={item.get('id')}: not requested via bot"
+
+    if event == "ManualInteractionRequired":
+        return _handle_manual_interaction(kind, item, title, requesters, payload)
+
+    if _failures_enabled() and item.get("id") is not None:
+        _stop_tracking(KIND_APP[kind], item["id"], "imported (webhook)")
+
+    sent = []
+    for uid in requesters:
+        if not _should_send((kind, item.get("id"), uid)):
+            sent.append(f"{uid}:debounced")
+            continue
+        text = translate(
+            f"notify_{kind}_available", user=_mention(uid), title=html.escape(title)
+        )
+        sent.append(f"{uid}:{'sent' if _send(text) else 'failed'}")
+    return f"{kind} id={item.get('id')} requesters " + ",".join(sent)
+
+
+class _Handler(BaseHTTPRequestHandler):
+    def log_message(self, fmt, *args):  # silence default stderr access log
+        pass
+
+    def _reply(self, code):
+        self.send_response(code)
+        self.send_header("Content-Length", "0")
+        self.end_headers()
+
+    def do_POST(self):
+        secret = str(getattr(settings, "searcharr_notify_secret", "") or "")
+        given = self.headers.get("X-Searcharr-Secret", "")
+        if not secret or not hmac.compare_digest(given.encode(), secret.encode()):
+            logger.warning(f"Rejected webhook to {self.path}: missing/wrong secret")
+            return self._reply(403)
+        try:
+            length = int(self.headers.get("Content-Length", 0))
+            if length > MAX_BODY:
+                return self._reply(413)
+            payload = json.loads(self.rfile.read(length) or b"{}")
+            if not isinstance(payload, dict):
+                raise ValueError("not an object")
+        except Exception:
+            logger.warning("Rejected webhook: bad JSON")
+            return self._reply(400)
+        try:
+            logger.info(f"Webhook: {handle_event(payload)}")
+        except Exception as e:
+            logger.error(f"Webhook handling error: {type(e).__name__}: {e}")
+        # always 200 so arr does not mark the connection failing over our own issues
+        self._reply(200)
+
+
+def start_listener():
+    """Start the listener in a daemon thread if enabled. Returns the server or None."""
+    if not getattr(settings, "searcharr_notify_enabled", False):
+        logger.info("Plex-available notifications disabled")
+        return None
+    port = int(getattr(settings, "searcharr_notify_port", 8086))
+    server = ThreadingHTTPServer(("127.0.0.1", port), _Handler)
+    server.daemon_threads = True
+    threading.Thread(target=server.serve_forever, name="notify", daemon=True).start()
+    if _failures_enabled():
+        init_tables()
+        threading.Thread(target=_checker_loop, name="notify-check", daemon=True).start()
+        logger.info(f"Failure notifications on: history check every {CHECK_INTERVAL}s")
+    logger.info(
+        f"Plex-available notification listener on 127.0.0.1:{port}, "
+        f"chat id {settings.searcharr_notify_chat_id}"
+    )
+    return server
