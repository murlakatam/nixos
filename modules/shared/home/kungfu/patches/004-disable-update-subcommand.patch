+/// This binary is built and installed by Nix (dotfiles nix-rebuild), which
+/// makes it immutable-by-convention; a self-replacing update would silently
+/// diverge it from the pinned rev the Nix store thinks is installed. Refuse
+/// unconditionally rather than letting it check, download, or replace.
+pub fn update(_check_only: bool, _to: Option<String>, _quiet: bool, _json: bool) -> Result<()> {
+    anyhow::bail!(
+        "kungfu update is disabled in this build — this kungfu is Nix-managed; bump the rev in its Nix package and rebuild instead"
+    );
 }
