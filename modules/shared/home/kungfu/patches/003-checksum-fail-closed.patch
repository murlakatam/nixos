# The self-updater's checksum check failed open: any error or 404 fetching
# SHA256SUMS let the update proceed unverified. Makes a missing/unreachable
# checksum fatal (bail!) instead of silently downgrading to
# Checksum::Unavailable. No upstream issue filed yet — drop this patch once
# kungfu itself fails closed here.
#
# Note: this Nix package builds from source and is immutable/Nix-managed;
# `kungfu update` self-replacing the running binary is not a supported way to
# upgrade it here regardless (use nix-rebuild). This patch is still worth
# carrying — it hardens the code path in case `kungfu update` is ever invoked
# directly against a Nix-built binary.
diff --git a/crates/kungfu-update/src/apply.rs b/crates/kungfu-update/src/apply.rs
index d3d5a99..2f6e4f2 100644
--- a/crates/kungfu-update/src/apply.rs
+++ b/crates/kungfu-update/src/apply.rs
@@ -130,18 +130,23 @@ fn cleanup_leftovers(dir: &Path) {
     let _ = std::fs::remove_file(dir.join("kungfu.exe.old"));
 }
 
